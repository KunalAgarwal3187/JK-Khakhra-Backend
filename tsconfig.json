{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "types": [
      "node"
    ],
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "api"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "prisma"
  ]
}